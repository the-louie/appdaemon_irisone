# appdaemon_irisone -- the irisone.* bus (PROJECT_RULES §4, T-66a / T-70).
# Copy to config.yaml on the AppDaemon host. config.yaml is gitignored.

presence:
  module: i1_presence
  class: PresencePublisher
  # REQUIRED, non-empty. One entry per person whose notifications are gated.
  persons:
    - person: person.alice             # must exist at start-up, or the app refuses to start (D1)
      key: alice                       # -> irisone.presence_alice ; [a-z][a-z0-9_]*, unique
      notify:                          # notify services WITHOUT "notify." ; each listed once, estate-wide
        - mobile_app_alice_phone
    - person: person.bob
      key: bob
      notify:
        - mobile_app_bob_phone
  # Optional. Defaults are the owner's 2026-10-29 decisions.
  away_debounce_s: 180                 # leaving home is published after this many seconds away (IQ-07)
  stale_after_s: 21600                 # a tracker silent this long publishes "unknown" (IQ-04)
  heartbeat_s: 300                     # republish interval, 60..3600; readers treat 3x this as stale

irisone:
  module: i1_irisone
  class: IrisoneHousekeeping
  # Optional.
  state_file: /conf/irisone_state.json   # gate counters, kept 14 days, survive restarts
  heartbeat_s: 300                       # republish interval for irisone.notify_gate_stats
  test_button: input_button.irisone_gate_test   # from deploy/ih_packages/irisone.yaml; null disables
  notification_channel: watchdog_alerts  # T-52: must be a channel enabled on the phones
